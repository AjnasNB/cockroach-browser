{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cockroachbrowser.com/schemas/action.schema.json",
  "title": "Cockroach Browser action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "purpose"
  ],
  "properties": {
    "kind": {
      "$ref": "#/$defs/actionKind"
    },
    "purpose": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "tabId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "xpath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "frame": {
      "$ref": "#/$defs/frameTarget"
    },
    "dialog": {
      "$ref": "#/$defs/dialogResponse"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "value": {
      "type": "string"
    },
    "valueRef": {
      "type": "string",
      "pattern": "^ref:"
    },
    "dataRef": {
      "type": "string",
      "pattern": "^ref:"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "expression": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "fullPage": {
      "type": "boolean"
    },
    "format": {
      "enum": [
        "png",
        "jpeg"
      ]
    },
    "quality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "deltaX": {
      "type": "number"
    },
    "deltaY": {
      "type": "number"
    },
    "button": {
      "enum": [
        "left",
        "right",
        "middle"
      ]
    },
    "clickCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "targetRef": {
      "type": "string"
    },
    "route": {
      "$ref": "#/$defs/networkRoute"
    },
    "routeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "waitUntil": {
      "enum": [
        "load",
        "domcontentloaded",
        "networkidle",
        "commit"
      ]
    },
    "approvalId": {
      "type": "string"
    }
  },
  "$defs": {
    "actionKind": {
      "enum": [
        "navigate",
        "back",
        "forward",
        "reload",
        "click",
        "doubleClick",
        "fill",
        "type",
        "press",
        "hover",
        "focus",
        "check",
        "uncheck",
        "select",
        "scroll",
        "drag",
        "mouse.move",
        "mouse.down",
        "mouse.up",
        "mouse.click",
        "keyboard.down",
        "keyboard.up",
        "keyboard.insertText",
        "upload",
        "download",
        "evaluate",
        "wait",
        "history.inspect",
        "network.route.add",
        "network.route.remove",
        "network.routes.list",
        "screenshot",
        "pdf",
        "snapshot",
        "extract",
        "cookies.read",
        "cookies.write",
        "storage.read",
        "storage.write",
        "tab.open",
        "tab.close",
        "tab.switch",
        "trace.start",
        "trace.stop"
      ]
    },
    "frameTarget": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        }
      }
    },
    "dialogResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "accept",
            "dismiss"
          ]
        },
        "promptTextRef": {
          "type": "string",
          "pattern": "^ref:"
        }
      }
    },
    "networkRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "pathPattern",
        "response"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#]+/?$"
        },
        "pathPattern": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 512
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ]
          }
        },
        "resourceTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "document",
              "stylesheet",
              "image",
              "media",
              "font",
              "script",
              "texttrack",
              "xhr",
              "fetch",
              "eventsource",
              "websocket",
              "manifest",
              "other"
            ]
          }
        },
        "response": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "const": "abort"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "const": "fulfill"
                },
                "status": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 599
                },
                "contentType": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "body": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  }
}
