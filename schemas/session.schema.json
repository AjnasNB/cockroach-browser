{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cockroachbrowser.com/schemas/session.schema.json",
  "title": "Cockroach Browser session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "policy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "purpose": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mode": {
      "enum": [
        "headless",
        "headed"
      ]
    },
    "startUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "timezoneId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 4320
        }
      }
    },
    "recordHar": {
      "type": "boolean"
    },
    "recordVideo": {
      "type": "boolean"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedOrigins"
      ],
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "deniedOrigins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "allowedActions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "action.schema.json#/$defs/actionKind"
          }
        },
        "allowedEffects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "write",
              "execute",
              "upload",
              "download",
              "credential"
            ]
          }
        },
        "allowedProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowJavaScript": {
          "type": "boolean"
        },
        "allowCookieRead": {
          "type": "boolean"
        },
        "allowCookieWrite": {
          "type": "boolean"
        },
        "allowDownloads": {
          "type": "boolean"
        },
        "allowUploads": {
          "type": "boolean"
        },
        "allowDialogAccept": {
          "type": "boolean"
        },
        "allowNetworkInterception": {
          "type": "boolean"
        },
        "allowPrivateNetwork": {
          "type": "boolean"
        },
        "allowRemote": {
          "type": "boolean"
        },
        "requireApprovalFor": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "action.schema.json#/$defs/actionKind"
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxActions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxDurationMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            "maxTabs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "maxDownloadBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxUploadBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxSnapshotChars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxEvidenceBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxHistoryEntries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxNetworkRules": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "maxRouteFulfillBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "maxInterceptedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        }
      }
    }
  }
}
