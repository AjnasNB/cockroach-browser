{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cockroach-browser",
  "main": "./site/worker.mjs",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cockroachbrowser.com/*",
      "zone_name": "cockroachbrowser.com"
    },
    {
      "pattern": "www.cockroachbrowser.com/*",
      "zone_name": "cockroachbrowser.com"
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
