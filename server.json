{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ajnasnb/cockroach-browser",
  "description": "Observation-first browser tools for authorized sessions, with Maqam-governed action proposals.",
  "repository": {
    "url": "https://github.com/AjnasNB/cockroach-browser",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "cockroach-browser",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "COCKROACH_BROWSER_URL",
          "description": "Authenticated Cockroach Browser daemon URL.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "COCKROACH_BROWSER_TOKEN",
          "description": "Bearer token for the Cockroach Browser daemon.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
